# ═══════════════════════════════════════════════════════════════════
# Cotizador GNP · configuración
#
# Copia este archivo como .env.local y llena los valores.
# .env.local NUNCA se sube a git: contiene la contraseña de GNP.
# ═══════════════════════════════════════════════════════════════════

# local | produccion
APP_ENV=local

# ── Base de datos ──────────────────────────────────────────────────
# Si se deja vacío usa datos/cotizador_gnp.sqlite
DB_PATH=

# ── Conexión con GNP (kit IC260812018) ─────────────────────────────
GNP_BASE_URL=https://api.service.gnp.com.mx
GNP_USUARIO=AESPIN870946
# ← contraseña del Portal de Intermediarios
GNP_PASSWORD=
GNP_ID_UNIDAD_OPERABLE=NOP0000016
GNP_INTERMEDIARIO=0073367001
GNP_TIMEOUT=60

# ── Correo al que GNP manda el PDF ─────────────────────────────────
# OJO: GNP envía el PDF por su cuenta a esta dirección, con su propio
# remitente y su propia plantilla. Si aquí se pone el correo del cliente,
# GNP le escribe directo y el vendedor se entera después.
# Mientras Comercial no decida otra cosa, va un buzón interno de Equinox.
GNP_CORREO_IMPRESION=agarcia@equinox.com.mx

# ── Migración desde Nexo (opcional) ────────────────────────────────
NEXO_STAGING_PATH=C:\xampp\htdocs\nexo\proyectos\nexo\app\core\staging\staging.sqlite

# ── Qualitas (ADR-010 punto 10 · docs/aseguradoras/qualitas/00-estado.md) ──
# Sólo cotización. Ninguna llamada sin autorización explícita en el chat.
# QA | PRODUCCION. La consideración 04 del XML (1 pruebas / 0 producción)
# sale de aquí, no se escribe a mano.
QUALITAS_AMBIENTE=QA
QUALITAS_URL_QA=https://qa.qualitas.com.mx:8443/WsEmision/WsEmision.asmx
# VACÍA a propósito hasta que se autorice producción. Documentada en el
# manual: http://sio.qualitas.com.mx/WsEmision/WsEmision.asmx (http, sin cifrar)
QUALITAS_URL_PRODUCCION=
# Nombre del parámetro de obtenerNuevaEmision [PENDIENTE]: en la imagen del
# WSDL del manual <wsdl:types> viene colapsado. Sin él no sale ninguna cotización.
QUALITAS_WS_PARAMETRO=xmlEmision
QUALITAS_TIMEOUT=60
QUALITAS_NEGOCIO=08902
QUALITAS_AGENTE=0008810
QUALITAS_DERECHOS=750
# Consideración 05. Máximo 14 (error 192 de Qualitas).
QUALITAS_PRONTO_PAGO_DIAS=14
# TarifaValores / TarifaCuotas / TarifaDerechos (los ejemplos mandan LINEA)
QUALITAS_TARIFA=LINEA
# Catálogo de vehículos (wsTarifa). Sólo hay URL de producción y en http:
# http://qbcenter.qualitas.com.mx/wsTarifa/wsTarifa.asmx — vacía hasta que
# se autorice cada descarga. Namespace no documentado [PENDIENTE].
QUALITAS_TARIFAS_URL=
QUALITAS_TARIFAS_NS=
# Qualitas no los ha entregado.
QUALITAS_CATALOGO_USUARIO=
QUALITAS_CATALOGO_TARIFA=
